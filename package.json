    "@capacitor/network": "^8.0.1",
    "@capacitor/status-bar": "^8.0.4",
    "@neondatabase/serverless": "^1.2.0",
    "@serwist/next": "^9.5.13",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.68.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.13",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
